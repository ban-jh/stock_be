<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.shaloman.pj.investment.execution.mapper.ExecutionMapper">
 <resultMap id="row" type="org.shaloman.pj.investment.execution.domain.ExecutionRecord">
  <id property="executionId" column="execution_id"/><result property="idempotencyKey" column="idempotency_key"/>
  <result property="triggerType" column="trigger_type"/><result property="executionMode" column="execution_mode"/>
  <result property="status" column="status"/><result property="strategyCode" column="strategy_code"/>
  <result property="strategyVersion" column="strategy_version"/><result property="startedAt" column="started_at"/>
  <result property="finishedAt" column="finished_at"/><result property="stopReason" column="stop_reason"/>
  <result property="summaryJson" column="summary_json"/>
 </resultMap>
 <select id="findRecent" resultMap="row">SELECT * FROM aim_execution ORDER BY started_at DESC LIMIT #{limit}</select>
 <select id="findById" resultMap="row">SELECT * FROM aim_execution WHERE execution_id=#{executionId}</select>
</mapper>